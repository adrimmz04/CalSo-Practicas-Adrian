digraph G {
  graph [rankdir=TB, fontname="Helvetica", fontsize=16, labelloc=t, nodesep=0.7, ranksep=0.55, pad=0.4, bgcolor="white",
         label="containsAllRequiredWeapons · V(G) = 5"];
  node  [shape=circle, fontname="Helvetica-Bold", fontsize=16, width=0.55, fixedsize=true, style=filled, fillcolor="#F1F1EE", color="#0E0E0F", penwidth=1.6];
  edge  [fontname="Helvetica", fontsize=11, color="#3A3A3D", fontcolor="#3A3A3D", penwidth=1.3, arrowsize=0.8];

  n1 [label="1"]; n2 [label="2"]; n3 [label="3"]; n4 [label="4"];
  n5 [label="5"]; n6 [label="6"];
  F  [label="F", shape=doublecircle, width=0.5, fillcolor="#E2E2DE"];

  n1 -> F  [label=" available == null\n (excepción)", color="#8E1B2C", fontcolor="#8E1B2C"];
  n1 -> n2 [label=" no nula"];
  n2 -> F  [label=" required == null\n (excepción)", color="#8E1B2C", fontcolor="#8E1B2C"];
  n2 -> n3 [label=" no nula"];
  n3 -> n4 [label=" quedan armas"];
  n3 -> n5 [label=" no quedan"];
  n4 -> n6 [label=" available vacía"];
  n4 -> n3 [label=" no vacía", constraint=false];
  n5 -> F  [label=" return true"];
  n6 -> F  [label=" return false"];

  leyenda [shape=box, style="rounded,filled", fillcolor="white", color="#E2E2DE", fontname="Helvetica", fontsize=11, fixedsize=false,
           label="1: if (available == null)\l2: if (required == null)\l3: for (Weapon weapon : required)\l4: if (available.isEmpty())\l5: return true\l6: return false\lF: fin del método\l"];
  { rank=same; n1; leyenda; }
  n1 -> leyenda [style=invis];
}
